# Copy this file to .env.local and fill in real values from your
# Firebase project's web app config (console.firebase.google.com ->
# Project settings -> General -> Your apps -> Web app).
#
# Until this file exists with real values, the app runs entirely on
# mock data (src/mock/) and never touches Firebase — this is expected
# and is today's intended state.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Dev-only — skips email-link wait, signs in directly if a matching
# Firestore student is found. NEVER set true in a deployed environment.
SKIP_EMAIL_LINK=false

# Admin Authentication
ADMIN_EMAIL=

# AI Grading (Groq - llama-3.3-70b-versatile)
GROQ_API_KEY=
